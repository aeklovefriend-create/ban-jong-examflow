function getAcademicDashboard(filters) { return withErrorHandling_('getAcademicDashboard', () => { requireUser_(['Academic','Admin']); filters=filters||{}; let rows=readRecords_('Submissions').records; rows=rows.filter(s=>!filters.status||s.Status===filters.status).filter(s=>!filters.grade||s.Grade===filters.grade).filter(s=>!filters.subjectCode||s.SubjectCode===filters.subjectCode).filter(s=>!filters.query||[s.SubmissionID,s.TeacherName,s.SubjectName,s.SubjectCode,s.Grade].join(' ').toLowerCase().includes(String(filters.query).toLowerCase())); const counts={total:rows.length,notSubmitted:0,underReview:rows.filter(s=>[CONFIG.STATUS.SUBMITTED,CONFIG.STATUS.UNDER_REVIEW,CONFIG.STATUS.RESUBMITTED].includes(s.Status)).length,needRevision:rows.filter(s=>s.Status===CONFIG.STATUS.NEED_REVISION).length,approved:rows.filter(s=>[CONFIG.STATUS.APPROVED,CONFIG.STATUS.READY_TO_PRINT,CONFIG.STATUS.PRINTED,CONFIG.STATUS.COMPLETED].includes(s.Status)).length,readyToPrint:rows.filter(s=>s.Status===CONFIG.STATUS.READY_TO_PRINT).length}; return {counts,submissions:rows.map(serializeSubmission_),filters:{grades:[...new Set(readRecords_('Submissions').records.map(s=>s.Grade).filter(Boolean))],subjects:readRecords_('Subjects').records}}; }); }
function getAcademicDashboard(filters) { return withErrorHandling_('getAcademicDashboard', () => { requireUser_(['Academic','Admin']); filters=filters||{}; let rows=readRecords_('Submissions').records; rows=rows.filter(s=>!filters.status||s.Status===filters.status).filter(s=>!filters.grade||s.Grade===filters.grade).filter(s=>!filters.subjectCode||s.SubjectCode===filters.subjectCode).filter(s=>!filters.query||[s.SubmissionID,s.TeacherName,s.SubjectName,s.SubjectCode,s.Grade].join(' ').toLowerCase().includes(String(filters.query).toLowerCase())); const all=readRecords_('Submissions').records; const teacherCount=readRecords_('Users').records.filter(u=>u.Role==='Teacher'&&String(u.Active).toLowerCase()!=='false').length; const subjectCount=readRecords_('Subjects').records.filter(s=>String(s.Active).toLowerCase()!=='false').length; const counts={total:rows.length,notSubmitted:Math.max(0,teacherCount*subjectCount-all.length),underReview:rows.filter(s=>[CONFIG.STATUS.SUBMITTED,CONFIG.STATUS.UNDER_REVIEW,CONFIG.STATUS.RESUBMITTED].includes(s.Status)).length,needRevision:rows.filter(s=>s.Status===CONFIG.STATUS.NEED_REVISION).length,approved:rows.filter(s=>[CONFIG.STATUS.APPROVED,CONFIG.STATUS.READY_TO_PRINT,CONFIG.STATUS.PRINTED,CONFIG.STATUS.COMPLETED].includes(s.Status)).length,readyToPrint:rows.filter(s=>s.Status===CONFIG.STATUS.READY_TO_PRINT).length}; const files=readRecords_('Files').records; return {counts,submissions:rows.map(s=>serializeSubmission_(s,files)),filters:{grades:[...new Set(readRecords_('Submissions').records.map(s=>s.Grade).filter(Boolean))],subjects:readRecords_('Subjects').records}}; }); }
function getMissingSubmissions() { const u=requireUser_(['Academic','Admin']); const users=readRecords_('Users').records.filter(x=>x.Role==='Teacher'&&String(x.Active).toLowerCase()!=='false'); const subjects=readRecords_('Subjects').records.filter(x=>String(x.Active).toLowerCase()!=='false'); const rows=readRecords_('Submissions').records; return users.flatMap(t=>subjects.filter(s=>!rows.some(r=>String(r.TeacherEmail).toLowerCase()===String(t.Email).toLowerCase()&&r.SubjectCode===s.SubjectCode)).map(s=>({teacherEmail:t.Email,teacherName:(t.FirstName+' '+t.LastName).trim(),subjectCode:s.SubjectCode,subjectName:s.SubjectName}))); }
function startReview(id) { const u=requireUser_(['Academic','Admin']); const s=getSubmission_(id); if([CONFIG.STATUS.SUBMITTED,CONFIG.STATUS.RESUBMITTED].includes(s.Status)) updateRecordById_('Submissions','SubmissionID',id,{Status:CONFIG.STATUS.UNDER_REVIEW,ReviewedAt:now_(),UpdatedAt:now_()}); logActivity_('เปิดตรวจข้อสอบ','Submission',id,'',u); return getSubmissionDetail(id); }
function saveReview(payload) { return withErrorHandling_('saveReview', () => { const u=requireUser_(['Academic','Admin']); const s=getSubmission_(payload.SubmissionID); if(![CONFIG.STATUS.SUBMITTED,CONFIG.STATUS.UNDER_REVIEW,CONFIG.STATUS.RESUBMITTED].includes(s.Status)) throw new Error('รายการนี้ไม่อยู่ในขั้นตอนตรวจ'); const fields=['FormatOk','QuestionCountOk','ScoreOk','InstructionOk','LanguageOk','OptionsOk','AnswerKeyOk','IndicatorAlignmentOk','CoverageOk','PrivacyOk','ReadyOk']; const review={ReviewID:makeId_('REV'),SubmissionID:s.SubmissionID,Version:s.CurrentVersion,...Object.fromEntries(fields.map(k=>[k,payload[k]===true||payload[k]==='true'])),Comment:safeString_(payload.Comment,2000),ReviewedBy:u.email,ReviewedAt:now_()}; appendRecord_('ReviewChecklist',review); const target=payload.action==='approve'?CONFIG.STATUS.APPROVED:CONFIG.STATUS.NEED_REVISION; if(payload.action==='revision') updateRecordById_('Submissions','SubmissionID',s.SubmissionID,{Status:target,LastComment:review.Comment,ReviewedAt:now_(),UpdatedAt:now_()}); else if(payload.action==='approve') { if(fields.some(k=>review[k]!==true)) throw new Error('กรุณาติ๊ก Checklist ให้ครบก่อนอนุมัติ'); updateRecordById_('Submissions','SubmissionID',s.SubmissionID,{Status:target,LastComment:review.Comment,ApprovedAt:now_(),ApprovedBy:u.email,UpdatedAt:now_()}); createCoverDocument(s.SubmissionID); notifyTeacher_(s,'ข้อสอบได้รับการอนุมัติและพร้อมพิมพ์'); } appendRecord_('ApprovalLogs',{ApprovalID:makeId_('APR'),SubmissionID:s.SubmissionID,FromStatus:s.Status,ToStatus:payload.action==='approve'?CONFIG.STATUS.READY_TO_PRINT:CONFIG.STATUS.NEED_REVISION,Action:payload.action,Comment:review.Comment,ActorEmail:u.email,ActorName:u.name,CreatedAt:now_()}); logActivity_(payload.action==='approve'?'อนุมัติข้อสอบ':'ส่งกลับแก้ไข','Submission',s.SubmissionID,review.Comment,u); return {ok:true,detail:getSubmissionDetail(s.SubmissionID)}; }); }
function queueForPrint(id,copyCount) { const u=requireUser_(['Academic','Admin']); const s=getSubmission_(id); if(s.Status!==CONFIG.STATUS.READY_TO_PRINT) throw new Error('รายการนี้ยังไม่พร้อมพิมพ์'); appendRecord_('PrintLogs',{PrintID:makeId_('PRINT'),SubmissionID:id,CopyCount:toNumber_(copyCount),PrintedBy:u.email,PrintedAt:'',Note:'รับเข้าคิวพิมพ์'}); logActivity_('รับเข้าคิวพิมพ์','Submission',id,'จำนวน '+copyCount,u); return {ok:true}; }
function markPrinted(id,copyCount,note) { const u=requireUser_(['Academic','Admin']); const s=getSubmission_(id); if(![CONFIG.STATUS.READY_TO_PRINT,CONFIG.STATUS.PRINTED].includes(s.Status)) throw new Error('สถานะไม่ถูกต้อง'); appendRecord_('PrintLogs',{PrintID:makeId_('PRINT'),SubmissionID:id,CopyCount:toNumber_(copyCount),PrintedBy:u.email,PrintedAt:now_(),Note:note||''}); updateRecordById_('Submissions','SubmissionID',id,{Status:CONFIG.STATUS.PRINTED,UpdatedAt:now_()}); logActivity_('บันทึกพิมพ์แล้ว','Submission',id,'จำนวน '+copyCount,u); return {ok:true}; }
function markCompleted(id) { const u=requireUser_(['Academic','Admin']); const s=getSubmission_(id); if(s.Status!==CONFIG.STATUS.PRINTED) throw new Error('ต้องบันทึกพิมพ์แล้วก่อนปิดงาน'); updateRecordById_('Submissions','SubmissionID',id,{Status:CONFIG.STATUS.COMPLETED,UpdatedAt:now_()}); logActivity_('ปิดงานข้อสอบ','Submission',id,'',u); return {ok:true}; }
