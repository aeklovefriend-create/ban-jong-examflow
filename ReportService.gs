function exportSubmissionsCsv(filters) { const u=requireUser_(['Academic','Admin']); const data=getAcademicDashboard(filters||{}).submissions; const rows=[['SubmissionID','TeacherName','SubjectName','Grade','Status','SubmittedAt','ApprovedAt'],...data.map(s=>[s.SubmissionID,s.TeacherName,s.SubjectName,s.Grade,s.statusTh,s.SubmittedAt,s.ApprovedAt])]; const csv=rows.map(r=>r.map(v=>'"'+String(v||'').replace(/"/g,'""')+'"').join(',')).join('\n'); const file=DriveApp.createFile('รายงานการส่งข้อสอบ-'+Utilities.formatDate(new Date(),CONFIG.DEFAULT_TIMEZONE,'yyyyMMdd-HHmm')+'.csv',csv,MimeType.CSV); logActivity_('Export CSV','Report',file.getId(),'Submissions',u); return {url:file.getUrl(),name:file.getName()}; }
function getActivityLogs(limit) { requireUser_(['Academic','Admin']); return readRecords_('ActivityLogs').records.slice(-(limit||100)).reverse(); }
