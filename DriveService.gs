function getOrCreateSubmissionFolder_(submission) { const root=DriveApp.getFolderById(getSetting_('ROOT_FOLDER_ID')); const year=getOrCreateFolder_(root,String(submission.AcademicYear)); const sem=getOrCreateFolder_(year,'ภาคเรียนที่ '+submission.Semester); const exam=getOrCreateFolder_(sem,submission.ExamType); const grade=getOrCreateFolder_(exam,submission.Grade); const subject=getOrCreateFolder_(grade,submission.SubjectCode+' '+submission.SubjectName); return getOrCreateFolder_(subject,submission.TeacherName+' '+submission.SubmissionID); }
function getOrCreateFolder_(parent,name) { const it=parent.getFoldersByName(name); return it.hasNext()?it.next():parent.createFolder(name); }
function saveUploadedFile_(submission, version, fileType, payload, actor) { if(!payload||!payload.dataUrl) throw new Error('กรุณาแนบไฟล์'); const parsed=parseDataUrl_(payload.dataUrl); if(CONFIG.ALLOWED_MIME_TYPES.indexOf(parsed.mime)<0) throw new Error('รองรับเฉพาะ PDF, DOC และ DOCX'); if(parsed.bytes.length>toNumber_(getSetting_('MAX_FILE_MB'),25)*1024*1024) throw new Error('ไฟล์มีขนาดใหญ่เกินกำหนด'); const folder=getOrCreateSubmissionFolder_(submission); const target=getOrCreateFolder_(folder,fileType==='EXAM'?'ข้อสอบ':fileType==='ANSWER'?'เฉลย':'Versions'); const name=safeString_(payload.name || fileType,120); const file=target.createFile(Utilities.newBlob(parsed.bytes,parsed.mime,name)); appendRecord_('Files',{FileID:makeId_('FILE'),SubmissionID:submission.SubmissionID,Version:version,FileType:fileType,FileName:name,MimeType:parsed.mime,SizeBytes:parsed.bytes.length,DriveFileId:file.getId(),DriveUrl:file.getUrl(),UploadedBy:actor.email,UploadedAt:now_(),Active:true}); return {id:file.getId(),name:file.getName(),url:file.getUrl(),size:file.getSize(),mimeType:file.getMimeType()}; }
function getSubmissionFiles_(id, version) { return readRecords_('Files').records.filter(f=>f.SubmissionID===id && (!version||String(f.Version)===String(version)) && String(f.Active).toLowerCase()!=='false').map(f=>({fileId:f.DriveFileId,fileName:f.FileName,fileType:f.FileType,url:f.DriveUrl,sizeBytes:f.SizeBytes,version:f.Version})); }
function createSubmissionFolderIfNeeded(id) { const s=getSubmission_(id); return getOrCreateSubmissionFolder_(s).getUrl(); }
