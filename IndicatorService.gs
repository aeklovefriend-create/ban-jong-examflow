function listIndicators(filters) { return withErrorHandling_('listIndicators', () => { requireUser_(['Teacher','Academic','Admin']); filters=filters||{}; const key='indicators_'+Utilities.base64EncodeWebSafe(JSON.stringify(filters)).slice(0,80); const cache=CacheService.getScriptCache(),hit=cache.get(key); if(hit)return JSON.parse(hit); const out=readRecords_('Indicators').records.filter(r=>String(r.Active).toLowerCase()!=='false').filter(r=>!filters.grade||r.Grade===filters.grade).filter(r=>!filters.subjectGroup||r.SubjectGroup===filters.subjectGroup).filter(r=>!filters.query||[r.Code,r.Description,r.Standard,r.Strand].join(' ').toLowerCase().includes(String(filters.query).toLowerCase())).map(r=>({id:r.IndicatorID,code:r.Code,description:r.Description,type:r.Type,grade:r.Grade,subjectGroup:r.SubjectGroup,strand:r.Strand,standard:r.Standard})); cache.put(key,JSON.stringify(out),300); return out; }); }
function saveIndicatorMappings(submissionId, version, mappings) { return withErrorHandling_('saveIndicatorMappings', () => { const u=requireUser_(['Teacher','Academic','Admin']); const sub=getSubmission_(submissionId); if (u.role==='Teacher' && sub.TeacherEmail.toLowerCase()!==u.email.toLowerCase()) throw new Error('คุณแก้ไขได้เฉพาะข้อสอบของตนเอง'); validateMappings_(sub.TotalQuestions, mappings); const old=readRecords_('ItemIndicators').records.filter(r=>r.SubmissionID===submissionId && String(r.Version)===String(version)); old.reverse().forEach(r=>getSheet_('ItemIndicators').deleteRow(r.__row)); (mappings||[]).forEach(m=>{const ind=readRecords_('Indicators').records.find(i=>i.IndicatorID===m.indicatorId); if(!ind) throw new Error('ไม่พบตัวชี้วัด'); appendRecord_('ItemIndicators',{MappingID:makeId_('MAP'),SubmissionID:submissionId,Version:version,StartItem:toNumber_(m.startItem),EndItem:toNumber_(m.endItem),IndicatorID:ind.IndicatorID,Code:ind.Code,Type:ind.Type,Description:ind.Description,ItemCount:toNumber_(m.endItem)-toNumber_(m.startItem)+1,CreatedBy:u.email,CreatedAt:now_()}); }); logActivity_('บันทึกการกำหนดตัวชี้วัด','Submission',submissionId,'Version '+version,u); return {ok:true}; }); }
function validateMappings_(total, mappings) { const n=toNumber_(total); if(!Array.isArray(mappings)||!mappings.length) throw new Error('กรุณากำหนดตัวชี้วัดอย่างน้อย 1 ช่วงข้อ'); const covered=[]; mappings.forEach(m=>{const s=toNumber_(m.startItem),e=toNumber_(m.endItem); if(s<1||e<s||e>n) throw new Error('ช่วงข้อสอบไม่ถูกต้อง'); for(let i=s;i<=e;i++) covered.push(i);}); const set=new Set(covered); if(set.size!==covered.length) throw new Error('มีช่วงข้อสอบซ้ำกัน'); const missing=[]; for(let i=1;i<=n;i++) if(!set.has(i)) missing.push(i); if(missing.length) throw new Error('ยังมีข้อสอบ '+missing.join(', ')+' ที่ยังไม่ได้กำหนดตัวชี้วัด'); }
function getMappings_(submissionId, version) { return readRecords_('ItemIndicators').records.filter(r=>r.SubmissionID===submissionId && String(r.Version)===String(version)).map(r=>({startItem:r.StartItem,endItem:r.EndItem,indicatorId:r.IndicatorID,code:r.Code,type:r.Type,description:r.Description,itemCount:r.ItemCount})); }
function getBlueprint(submissionId) { const s=getSubmission_(submissionId); const maps=getMappings_(submissionId,s.CurrentVersion); const total=toNumber_(s.TotalQuestions); const grouped={}; maps.forEach(m=>{const k=m.code; if(!grouped[k]) grouped[k]={code:m.code,type:m.type,description:m.description,count:0,items:[]}; grouped[k].count+=toNumber_(m.itemCount); grouped[k].items.push(m.startItem+'–'+m.endItem);}); return {total, rows:Object.keys(grouped).map(k=>({...grouped[k],percent:total?Math.round(grouped[k].count/total*10000)/100:0})), mappings:maps}; }
function importIndicators(rows) { const u=requireUser_(['Admin']); if(!Array.isArray(rows)) throw new Error('รูปแบบข้อมูลไม่ถูกต้อง'); rows.forEach(r=>appendRecord_('Indicators',{IndicatorID:safeString_(r.IndicatorID,80)||makeId_('IND'),AcademicYear:safeString_(r.AcademicYear||getSetting_('ACADEMIC_YEAR'),10),SubjectGroup:safeString_(r.SubjectGroup,100),Grade:safeString_(r.Grade,30),Strand:safeString_(r.Strand,120),Standard:safeString_(r.Standard,120),Code:safeString_(r.Code,80),Description:safeString_(r.Description,1000),Type:['ระหว่างทาง','ปลายทาง'].includes(r.Type)?r.Type:'ระหว่างทาง',Active:r.Active===false?'false':true})); logActivity_('นำเข้าตัวชี้วัด','Indicators','',rows.length+' records',u); return {ok:true,count:rows.length}; }
