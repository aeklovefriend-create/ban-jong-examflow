function adminGetConfiguration() { requireUser_(['Admin']); return {users:readRecords_('Users').records,subjects:readRecords_('Subjects').records,classes:readRecords_('Classes').records,examTypes:readRecords_('ExamTypes').records,settings:readRecords_('Settings').records}; }
function adminSaveUser(user) { const u=requireUser_(['Admin']); const email=safeString_(user.Email,200).toLowerCase(); if(!email||email.indexOf('@')<1) throw new Error('อีเมลไม่ถูกต้อง'); const existing=readRecords_('Users').records.find(r=>String(r.Email).toLowerCase()===email); const row={UserID:existing?existing.UserID:makeId_('USR'),Email:email,FirstName:safeString_(user.FirstName,80),LastName:safeString_(user.LastName,80),Position:safeString_(user.Position,100),SubjectGroup:safeString_(user.SubjectGroup,100),Role:['Teacher','Academic','Admin'].includes(user.Role)?user.Role:'Teacher',Active:user.Active===false?'false':true,CreatedAt:existing?existing.CreatedAt:now_(),UpdatedAt:now_()}; if(existing)updateRecordById_('Users','UserID',existing.UserID,row);else appendRecord_('Users',row);logActivity_('แก้ไขผู้ใช้งาน','User',row.UserID,row.Email,u);return row; }
function adminSaveSubject(subject) { const u=requireUser_(['Admin']); const code=safeString_(subject.SubjectCode,50); if(!code)throw new Error('ต้องระบุรหัสวิชา'); const existing=readRecords_('Subjects').records.find(r=>r.SubjectCode===code); const row={SubjectCode:code,SubjectName:safeString_(subject.SubjectName,100),SubjectGroup:safeString_(subject.SubjectGroup,100),Grades:safeString_(subject.Grades,100),Active:subject.Active===false?'false':true};if(existing)updateRecordById_('Subjects','SubjectCode',code,row);else appendRecord_('Subjects',row);logActivity_('แก้ไขรายวิชา','Subject',code,row.SubjectName,u);return row; }
function adminSaveClass(item) { const u=requireUser_(['Admin']); const grade=safeString_(item.Grade,30),room=safeString_(item.Room,30); const rs=readRecords_('Classes').records.find(r=>r.Grade===grade&&String(r.Room)===room); const row={Grade:grade,Room:room,StudentCount:toNumber_(item.StudentCount),Active:item.Active===false?'false':true};if(rs){const sh=getSheet_('Classes'),data=sh.getDataRange().getValues(),map=headerMap_(data[0]),idx=data.findIndex((r,i)=>i>0&&String(r[map.Grade])===grade&&String(r[map.Room])===room);if(idx>0)sh.getRange(idx+1,1,1,data[0].length).setValues([data[idx].map((v,i)=>data[0][i] in row?row[data[0][i]]:v)]);}else appendRecord_('Classes',row);logActivity_('แก้ไขชั้นเรียน','Class',grade+'-'+room,'',u);return row; }
function adminSaveSetting(key,value,description) { const u=requireUser_(['Admin']); if(!/^[A-Z0-9_]+$/.test(String(key)))throw new Error('Key ตั้งค่าไม่ถูกต้อง'); setSetting_(key,safeString_(value,500),description);logActivity_('แก้ไขการตั้งค่า','Setting',key,String(value),u);return {key:key,value:value}; }
