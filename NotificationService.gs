function notifyTeacher_(s, message) { if(!s.TeacherEmail) return; try { MailApp.sendEmail({to:s.TeacherEmail,subject:CONFIG.APP_NAME+' - แจ้งเตือนข้อสอบ '+s.SubmissionID,htmlBody:'<p>'+message+'</p><p>สถานะ: '+(CONFIG.STATUS_TH[s.Status]||s.Status)+'</p>'}); } catch(e) { logError_('notifyTeacher_',e); } }
function notifyAcademic_(s,message) { const recipients=readRecords_('Users').records.filter(u=>['Academic','Admin'].includes(u.Role)&&String(u.Active).toLowerCase()!=='false').map(u=>u.Email).filter(Boolean); if(!recipients.length) return; try { MailApp.sendEmail({to:recipients.join(','),subject:CONFIG.APP_NAME+' - '+s.SubmissionID,htmlBody:'<p>'+message+'</p><p>ครูผู้ส่ง: '+s.TeacherName+'</p>'}); } catch(e) { logError_('notifyAcademic_',e); } }
function deadlineNotifier() { const end=getSetting_('DEADLINE_END'); if(!end) return; const days=Math.ceil((new Date(end)-new Date())/86400000); if(days>3||days<0) return; const sent=readRecords_('Submissions').records; const pending=sent.filter(s=>[CONFIG.STATUS.DRAFT].includes(s.Status)); pending.forEach(s=>notifyTeacher_(s,days===0?'วันนี้เป็นวันสุดท้ายของการส่งข้อสอบ':'เหลือเวลาอีก '+days+' วันก่อนถึงกำหนดส่ง')); }
