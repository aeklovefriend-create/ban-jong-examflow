function getTeacherDashboard() { return withErrorHandling_('getTeacherDashboard', () => { const u=requireUser_(['Teacher','Academic','Admin']); const rows=readRecords_('Submissions').records.filter(s=>u.role==='Teacher'?String(s.TeacherEmail).toLowerCase()===u.email.toLowerCase():true); const statuses=Object.keys(CONFIG.STATUS_TH); const counts={}; statuses.forEach(s=>counts[s]=rows.filter(r=>r.Status===s).length); const assigned=readRecords_('Subjects').records.filter(s=>String(s.Active).toLowerCase()!=='false').length; const submitted=rows.filter(r=>![CONFIG.STATUS.DRAFT].includes(r.Status)).length; const files=readRecords_('Files').records; return {counts,submissions:rows.sort((a,b)=>String(b.UpdatedAt).localeCompare(String(a.UpdatedAt))).map(s=>serializeSubmission_(s,files)),progress:{assigned,submitted,percent:assigned?Math.round(submitted/assigned*100):0},settings:getPublicSettings_()}; }); }
function serializeSubmission_(s,fileRecords) { const base=json_(s); const files=(fileRecords||readRecords_('Files').records).filter(f=>f.SubmissionID===s.SubmissionID&&(!s.CurrentVersion||String(f.Version)===String(s.CurrentVersion))&&String(f.Active).toLowerCase()!=='false').map(f=>({fileId:f.DriveFileId,fileName:f.FileName,fileType:f.FileType,url:f.DriveUrl,sizeBytes:f.SizeBytes,version:f.Version})); return {...base,statusTh:CONFIG.STATUS_TH[s.Status]||s.Status,submittedAtText:dateText_(s.SubmittedAt),approvedAtText:dateText_(s.ApprovedAt),dueDateText:dateText_(s.DueDate),files}; }
function getFormOptions() { requireUser_(['Teacher','Academic','Admin']); return {subjects:readRecords_('Subjects').records.filter(r=>String(r.Active).toLowerCase()!=='false'),classes:readRecords_('Classes').records.filter(r=>String(r.Active).toLowerCase()!=='false'),examTypes:readRecords_('ExamTypes').records.filter(r=>String(r.Active).toLowerCase()!=='false'),settings:getPublicSettings_()}; }
function getPublicSettings_() { const keys=['SCHOOL_NAME','ACADEMIC_YEAR','SEMESTER','DEADLINE_START','DEADLINE_END','PRIMARY_COLOR','SECONDARY_COLOR']; const o={}; keys.forEach(k=>o[k]=getSetting_(k)); return o; }
function getSubmission_(id) { const s=readRecords_('Submissions').records.find(x=>x.SubmissionID===id); if(!s) throw new Error('ไม่พบข้อสอบรายการนี้'); return s; }
function saveDraft(payload) { return withErrorHandling_('saveDraft', () => { const u=requireUser_(['Teacher','Academic','Admin']); payload=payload||{}; const id=payload.SubmissionID||generateSubmissionId_(payload); const existing=readRecords_('Submissions').records.find(s=>s.SubmissionID===id); if(existing && u.role==='Teacher' && existing.TeacherEmail.toLowerCase()!==u.email.toLowerCase()) throw new Error('ไม่มีสิทธิ์แก้ไขรายการนี้'); if(existing && u.role==='Teacher' && ![CONFIG.STATUS.DRAFT,CONFIG.STATUS.NEED_REVISION].includes(existing.Status)) throw new Error('รายการนี้ส่งแล้วหรืออนุมัติแล้ว ไม่สามารถแก้ไขข้อมูลได้'); const row={SubmissionID:id,TeacherEmail:existing?existing.TeacherEmail:u.email,TeacherName:existing?existing.TeacherName:u.name,AcademicYear:safeString_(payload.AcademicYear||getSetting_('ACADEMIC_YEAR'),10),Semester:safeString_(payload.Semester||getSetting_('SEMESTER'),5),ExamType:safeString_(payload.ExamType,50),SubjectCode:safeString_(payload.SubjectCode,50),SubjectName:safeString_(payload.SubjectName,100),Grade:safeString_(payload.Grade,30),Room:safeString_(payload.Room,30),TotalQuestions:toNumber_(payload.TotalQuestions),TotalScore:toNumber_(payload.TotalScore),ExamDuration:toNumber_(payload.ExamDuration),StudentCount:toNumber_(payload.StudentCount),CopyCount:toNumber_(payload.CopyCount),Status:existing?existing.Status:CONFIG.STATUS.DRAFT,CurrentVersion:existing?existing.CurrentVersion||1:1,SubmittedAt:existing?existing.SubmittedAt:'',ReviewedAt:existing?existing.ReviewedAt:'',ApprovedAt:existing?existing.ApprovedAt:'',ApprovedBy:existing?existing.ApprovedBy:'',CreatedAt:existing?existing.CreatedAt:now_(),UpdatedAt:now_(),DueDate:getSetting_('DEADLINE_END'),LastComment:existing?existing.LastComment:'',CoverFileId:existing?existing.CoverFileId:'',ExamFolderId:existing?existing.ExamFolderId:''}; if(existing) updateRecordById_('Submissions','SubmissionID',id,row); else appendRecord_('Submissions',row); logActivity_('บันทึกร่าง','Submission',id,'',u); return {ok:true,submissionId:id,submission:serializeSubmission_(row)}; }); }
function submitSubmission(payload) { return withErrorHandling_('submitSubmission', () => { const u=requireUser_(['Teacher','Academic','Admin']); const lock=LockService.getScriptLock(); lock.waitLock(20000); try { const draft=saveDraft(payload); let s=getSubmission_(draft.submissionId); const fromStatus=s.Status; if(!payload.questionFile||!payload.answerFile) throw new Error('กรุณาแนบไฟล์ข้อสอบและเฉลย'); const maps=payload.mappings||[]; validateMappings_(s.TotalQuestions,maps); let version=toNumber_(s.CurrentVersion,1); if(s.Status===CONFIG.STATUS.NEED_REVISION) { version+=1; updateRecordById_('Submissions','SubmissionID',s.SubmissionID,{CurrentVersion:version,Status:CONFIG.STATUS.DRAFT,UpdatedAt:now_()}); s=getSubmission_(s.SubmissionID); } const q=saveUploadedFile_(s,version,'EXAM',payload.questionFile,u); const a=saveUploadedFile_(s,version,'ANSWER',payload.answerFile,u); saveIndicatorMappings(s.SubmissionID,version,maps); const nextStatus=version>1?CONFIG.STATUS.RESUBMITTED:CONFIG.STATUS.SUBMITTED; updateRecordById_('Submissions','SubmissionID',s.SubmissionID,{Status:nextStatus,CurrentVersion:version,SubmittedAt:now_(),UpdatedAt:now_(),ExamFolderId:getOrCreateSubmissionFolder_(s).getId()}); appendRecord_('Versions',{VersionID:makeId_('VER'),SubmissionID:s.SubmissionID,Version:version,QuestionFileId:q.id,AnswerFileId:a.id,Comment:payload.comment||'',Status:nextStatus,UploadedBy:u.email,UploadedAt:now_()}); appendRecord_('ApprovalLogs',{ApprovalID:makeId_('APR'),SubmissionID:s.SubmissionID,FromStatus:fromStatus,ToStatus:nextStatus,Action:'submit',Comment:payload.comment||'',ActorEmail:u.email,ActorName:u.name,CreatedAt:now_()}); logActivity_('ส่งข้อสอบ','Submission',s.SubmissionID,'Version '+version,u); notifyAcademic_(s,'ส่งข้อสอบ '+s.SubmissionID+' เรียบร้อยแล้ว'); return {ok:true,submissionId:s.SubmissionID}; } finally { lock.releaseLock(); } }); }
function saveRevision(payload) { const u=requireUser_(['Teacher','Academic','Admin']); const s=getSubmission_(payload.SubmissionID); if(u.role==='Teacher'&&s.TeacherEmail.toLowerCase()!==u.email.toLowerCase()) throw new Error('ไม่มีสิทธิ์แก้ไขรายการนี้'); const next=toNumber_(s.CurrentVersion,1)+1; updateRecordById_('Submissions','SubmissionID',s.SubmissionID,{CurrentVersion:next,Status:CONFIG.STATUS.DRAFT,UpdatedAt:now_()}); payload.CurrentVersion=next; return submitSubmission({...payload,SubmissionID:s.SubmissionID}); }
function getSubmissionDetail(id) { const u=requireUser_(['Teacher','Academic','Admin']); const s=getSubmission_(id); if(u.role==='Teacher'&&s.TeacherEmail.toLowerCase()!==u.email.toLowerCase()) throw new Error('ไม่มีสิทธิ์เข้าถึงรายการนี้'); return {submission:serializeSubmission_(s),files:getSubmissionFiles_(id),versions:readRecords_('Versions').records.filter(v=>v.SubmissionID===id),mappings:getMappings_(id,s.CurrentVersion),blueprint:getBlueprint(id),review:readRecords_('ReviewChecklist').records.filter(r=>r.SubmissionID===id).pop()||null}; }
function getPublicStatus(id) { const s=getSubmission_(id); return {submissionId:s.SubmissionID,schoolName:getSetting_('SCHOOL_NAME')||CONFIG.SCHOOL_NAME,subjectName:s.SubjectName,subjectCode:s.SubjectCode,grade:s.Grade,examType:s.ExamType,academicYear:s.AcademicYear,semester:s.Semester,status:s.Status,statusTh:CONFIG.STATUS_TH[s.Status]||s.Status,updatedAt:dateText_(s.UpdatedAt),version:s.CurrentVersion}; }
