function createCoverDocument(submissionId) { return withErrorHandling_('createCoverDocument', () => { const u=requireUser_(['Academic','Admin']); const s=getSubmission_(submissionId); if(![CONFIG.STATUS.APPROVED,CONFIG.STATUS.READY_TO_PRINT,CONFIG.STATUS.PRINTED,CONFIG.STATUS.COMPLETED].includes(s.Status)) throw new Error('สร้างใบปะหน้าได้หลังอนุมัติเท่านั้น'); const folder=getOrCreateSubmissionFolder_(s); const coverFolder=getOrCreateFolder_(folder,'ใบปะหน้า'); const templateId=getSetting_('COVER_TEMPLATE_ID'); let doc; if(templateId){ const copy=DriveApp.getFileById(templateId).makeCopy('ใบปะหน้า '+s.SubmissionID,coverFolder); doc=DocumentApp.openById(copy.getId()); } else { doc=DocumentApp.create('ใบปะหน้า '+s.SubmissionID); } const body=doc.getBody(); body.setMarginTop(36).setMarginBottom(36).setMarginLeft(42).setMarginRight(42); body.appendParagraph(getSetting_('SCHOOL_NAME')||CONFIG.SCHOOL_NAME).setHeading(DocumentApp.ParagraphHeading.TITLE).setAlignment(DocumentApp.HorizontalAlignment.CENTER); body.appendParagraph('ใบปะหน้าข้อสอบ').setHeading(DocumentApp.ParagraphHeading.HEADING1).setAlignment(DocumentApp.HorizontalAlignment.CENTER); body.appendParagraph((s.ExamType||'')+' ปีการศึกษา '+s.AcademicYear+' ภาคเรียนที่ '+s.Semester).setAlignment(DocumentApp.HorizontalAlignment.CENTER); const info=body.appendTable([['รหัสวิชา',s.SubjectCode,'ชื่อวิชา',s.SubjectName],['ชั้น',s.Grade,'ห้อง',s.Room],['จำนวนข้อ',String(s.TotalQuestions),'คะแนนเต็ม',String(s.TotalScore)],['เวลา',String(s.ExamDuration)+' นาที','จำนวนนักเรียน',String(s.StudentCount)],['จำนวนชุด',String(s.CopyCount),'ครูผู้สอน',s.TeacherName],['Submission ID',s.SubmissionID,'วันที่อนุมัติ',dateText_(s.ApprovedAt)]]); info.setBorderWidth(0.5); body.appendParagraph('ตารางวิเคราะห์ตัวชี้วัดของข้อสอบ').setHeading(DocumentApp.ParagraphHeading.HEADING2); const t=body.appendTable([['ลำดับ','ข้อสอบข้อที่','รหัสตัวชี้วัด','รายละเอียดตัวชี้วัด','ประเภท','จำนวนข้อ']]); getMappings_(submissionId,s.CurrentVersion).forEach((m,i)=>{ const row=t.appendTableRow(); [String(i+1),m.startItem+'–'+m.endItem,m.code,m.description,m.type,String(m.itemCount)].forEach(v=>row.appendTableCell(v)); }); const bp=getBlueprint(submissionId); body.appendParagraph('จำนวนข้อทั้งหมด: '+bp.total+' ข้อ'); body.appendParagraph('ปลายทาง: '+bp.rows.filter(r=>r.type==='ปลายทาง').reduce((a,r)=>a+r.count,0)+' ข้อ | ระหว่างทาง: '+bp.rows.filter(r=>r.type==='ระหว่างทาง').reduce((a,r)=>a+r.count,0)+' ข้อ'); const statusUrl=getStatusUrl_(submissionId); body.appendParagraph('สแกน QR เพื่อดูสถานะ: '+statusUrl); try { body.appendImage(UrlFetchApp.fetch('https://quickchart.io/qr?size=180&text='+encodeURIComponent(statusUrl)).getBlob()).setWidth(120).setHeight(120); } catch(qrError) { logError_('createCoverDocument.qr',qrError); } doc.saveAndClose(); const file=DriveApp.getFileById(doc.getId()); if(!templateId){ coverFolder.addFile(file); DriveApp.getRootFolder().removeFile(file); } const pdf=coverFolder.createFile(file.getAs(MimeType.PDF).setName('ใบปะหน้า-'+s.SubmissionID+'.pdf')); updateRecordById_('Submissions','SubmissionID',submissionId,{CoverFileId:pdf.getId(),Status:CONFIG.STATUS.READY_TO_PRINT,UpdatedAt:now_()}); logActivity_('สร้างใบปะหน้า','Submission',submissionId,pdf.getUrl(),u); return {docUrl:doc.getUrl(),pdfUrl:pdf.getUrl(),pdfId:pdf.getId()}; }); }
function getStatusUrl_(id) { const url=ScriptApp.getService().getUrl(); return (url||'')+'?submission='+encodeURIComponent(id); }
function getCoverPdf(id) { const u=requireUser_(['Teacher','Academic','Admin']); const s=getSubmission_(id); if(u.role==='Teacher'&&s.TeacherEmail.toLowerCase()!==u.email.toLowerCase()) throw new Error('ไม่มีสิทธิ์'); if(!s.CoverFileId) return createCoverDocument(id); const f=DriveApp.getFileById(s.CoverFileId); return {pdfUrl:f.getUrl(),pdfId:f.getId()}; }
